Implementing caching using Redis in a backend application (like Node.js / Express) typically follows the **Cache-Aside (Lazy Loading)** pattern. This pattern fetches data from Redis first; if present (Cache Hit), it returns immediately. If missing (Cache Miss), it fetches the data from the primary database, populates Redis with an expiration time (TTL), and returns the data.

Here is a step-by-step guide and production-ready implementation.

---

### 1. Redis Client Setup

Install the official Redis package for Node.js:

```bash
npm install redis

```

Configure a centralized Redis connection module (`redisClient.js`):

```javascript
const { createClient } = require('redis');

const redisClient = createClient({
  url: process.env.REDIS_URL || 'redis://localhost:6379',
});

redisClient.on('error', (err) => console.error('Redis Client Error:', err));
redisClient.on('connect', () => console.log('Connected to Redis server'));

// Connect asynchronously during server bootstrap
(async () => {
  await redisClient.connect();
})();

module.exports = redisClient;

```

---

### 2. Implementing the Cache-Aside Pattern

Here is an Express controller function demonstrating how to cache a database query response using Redis:

```javascript
const redisClient = require('./redisClient');
const User = require('./models/User'); // Mongoose or SQL model

async function getUserProfile(req, res) {
  const { userId } = req.params;
  const cacheKey = `user:${userId}:profile`;

  try {
    // Step 1: Check Redis cache
    const cachedData = await redisClient.get(cacheKey);

    if (cachedData) {
      console.log('Cache Hit!');
      return res.json({
        source: 'cache',
        data: JSON.parse(cachedData),
      });
    }

    // Step 2: Cache Miss - Query primary database
    console.log('Cache Miss! Fetching from DB...');
    const user = await User.findById(userId).lean();

    if (!user) {
      return res.status(404).json({ message: 'User not found' });
    }

    // Step 3: Populate Redis cache with a 1-hour TTL (3600 seconds)
    await redisClient.set(cacheKey, JSON.stringify(user), {
      EX: 3600, // Expiration time in seconds
    });

    // Step 4: Return response
    return res.json({
      source: 'database',
      data: user,
    });
  } catch (error) {
    console.error('Error fetching user profile:', error);
    return res.status(500).json({ message: 'Internal server error' });
  }
}

```

