### 3. Cache Invalidation Strategy (Write-Through / Mutate-on-Write)

To prevent users from reading stale data after a database update, invalidate or update the corresponding key in Redis immediately upon mutation:

```javascript
async function updateUserProfile(req, res) {
  const { userId } = req.params;
  const updateData = req.body;
  const cacheKey = `user:${userId}:profile`;

  try {
    // Step 1: Update primary database
    const updatedUser = await User.findByIdAndUpdate(userId, updateData, { new: true });

    if (!updatedUser) {
      return res.status(404).json({ message: 'User not found' });
    }

    // Step 2: Invalidate the Redis cache key
    await redisClient.del(cacheKey);

    // Alternative (Write-Through): Update cache with new data
    // await redisClient.set(cacheKey, JSON.stringify(updatedUser), { EX: 3600 });

    return res.json({ message: 'Profile updated successfully', data: updatedUser });
  } catch (error) {
    console.error('Error updating user profile:', error);
    return res.status(500).json({ message: 'Internal server error' });
  }
}

```

