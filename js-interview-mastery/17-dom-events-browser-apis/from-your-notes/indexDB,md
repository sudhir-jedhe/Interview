## 3. Step 3: Integrating into Web Application UI

```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SharedWorker Hub Demo</title>
</head>
<body>
  <h1>Multi-Tab WebSocket & IndexedDB Hub</h1>
  <p>Status: <strong id="status">Connecting...</strong></p>

  <input type="text" id="msgInput" placeholder="Type a message..." />
  <button id="sendBtn">Send Message</button>

  <h3>Message History (Persisted in IndexedDB):</h3>
  <ul id="messageList"></ul>

  <script src="hub-client.js"></script>
  <script>
    const hub = new SharedHubClient();

    const statusEl = document.getElementById("status");
    const listEl = document.getElementById("messageList");
    const inputEl = document.getElementById("msgInput");
    const sendBtn = document.getElementById("sendBtn");

    // 1. Listen for real-time WebSocket connection status updates
    hub.on("SOCKET_STATUS", (status) => {
      statusEl.textContent = status;
      statusEl.style.color = status === "CONNECTED" ? "green" : "red";
    });

    // 2. Listen for real-time incoming messages pushed to all open tabs
    hub.on("NEW_MESSAGE", (msg) => {
      appendMessageToUI(msg);
    });

    // 3. Load persisted history from IndexedDB on page load
    window.addEventListener("DOMContentLoaded", async () => {
      try {
        const history = await hub.getHistory();
        history.forEach(appendMessageToUI);
      } catch (err) {
        console.error("Failed to load history:", err);
      }
    });

    // 4. Send message over WebSocket via SharedWorker
    sendBtn.addEventListener("click", async () => {
      const text = inputEl.value.trim();
      if (!text) return;

      try {
        await hub.sendMessageOverSocket(text);
        inputEl.value = "";
      } catch (err) {
        alert("Failed to send: " + err.message);
      }
    });

    function appendMessageToUI(msg) {
      const li = document.createElement("li");
      li.textContent = `[${new Date(msg.timestamp).toLocaleTimeString()}] ${msg.text}`;
      listEl.appendChild(li);
    }
  </script>
</body>
</html>

```

---

## Summary Advantages

| Problem                  | Standard Tab Approach                                                                   | SharedWorker Architecture                                                         |
| ------------------------ | --------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------- |
| **WebSocket Overhead**   | Opening $N$ tabs creates $N$ separate socket connections.                               | Maintains **exactly 1** socket connection across all tabs.                        |
| **Database Concurrency** | Tabs contend for IndexedDB transaction locks and trigger `onblocked` schema locks.      | All database reads/writes are serialized inside a **single thread**.              |
| **Real-time Sync**       | Requires manual `BroadcastChannel` or `localStorage` event wiring to update other tabs. | Worker pushes socket events and database payloads directly to all open tab ports. |

Explain the idb library wrapper for IndexedDB with async/await code examples

The native IndexedDB API relies heavily on legacy event listeners (`request.onsuccess`, `request.onerror`, `request.onupgradeneeded`) and callback chains, which makes handling transactions verbose and error-prone.

The **`idb` library** (created by Jake Archibald / Google) is a lightweight wrapper that transforms native IndexedDB into clean **Promise-based API** compatible with `async/await`.

---

## 1. Native IndexedDB vs. `idb` Library

| Task                       | Native IndexedDB                   | `idb` Library Wrapper                                        |
| -------------------------- | ---------------------------------- | ------------------------------------------------------------ |
| **Database Opening**       | Event-driven (`request.onsuccess`) | `await openDB(name, version, upgradeCallback)`               |
| **Error Handling**         | `request.onerror` callbacks        | Standard JavaScript `try...catch` blocks                     |
| **Transaction Completion** | `tx.oncomplete` callback           | `await tx.done`                                              |
| **Simple Reads/Writes**    | Manual transaction setup required  | Direct shortcut methods (`await db.get()`, `await db.put()`) |

---

## 2. Installation & Setup

```bash
npm install idb

```

You can import it in ES modules or bundlers:

```javascript
import { openDB } from 'idb';

```

---

## 3. Creating & Upgrading a Database (`openDB`)

The `openDB` function replaces native `indexedDB.open()`. The third parameter is an `upgrade` callback where you define object stores and indexes.

```javascript
import { openDB } from 'idb';

async function initDB() {
  const db = await openDB('AppDatabase', 1, {
    upgrade(db, oldVersion, newVersion, transaction) {
      console.log(`Upgrading database from v${oldVersion} to v${newVersion}`);

      // Create an object store with auto-incrementing key
      if (!db.objectStoreNames.contains('users')) {
        const userStore = db.createObjectStore('users', {
          keyPath: 'id',
          autoIncrement: true,
        });

        // Create secondary index for searching by email
        userStore.createIndex('by-email', 'email', { unique: true });
      }
    },
  });

  return db;
}

```

---

## 4. Basic CRUD Operations (Shortcut Methods)

For simple single-record reads, writes, and deletes, `idb` provides convenient shortcut methods directly on the `db` instance without requiring explicit transaction boilerplate.

```javascript
async function performCRUD() {
  const db = await initDB();

  // 1. CREATE / UPDATE (db.put or db.add)
  const userId = await db.put('users', {
    name: 'Alice Smith',
    email: 'alice@example.com',
    role: 'Admin',
  });
  console.log('Saved user with key:', userId);

  // 2. READ (db.get)
  const user = await db.get('users', userId);
  console.log('Fetched user:', user);

  // 3. READ ALL (db.getAll)
  const allUsers = await db.getAll('users');
  console.log('All users count:', allUsers.length);

  // 4. DELETE (db.delete)
  await db.delete('users', userId);
  console.log('User deleted successfully.');
}

```

---

## 5. Explicit Transactions (`await tx.done`)

When performing multiple dependent reads and writes, wrap them in an explicit transaction. Use **`await tx.done`** to ensure the entire transaction commits safely to disk.

```javascript
async function transferCredits(senderId, recipientId, amount) {
  const db = await initDB();

  // Open a readwrite transaction across the 'users' store
  const tx = db.transaction('users', 'readwrite');
  const store = tx.objectStore('users');

  try {
    // Perform multiple operations within the same transaction scope
    const sender = await store.get(senderId);
    const recipient = await store.get(recipientId);

    if (!sender || sender.credits < amount) {
      throw new Error('Insufficient credits or invalid sender.');
    }

    sender.credits -= amount;
    recipient.credits += amount;

    await store.put(sender);
    await store.put(recipient);

    // Guarantee transaction completes successfully
    await tx.done;
    console.log('Credit transfer committed to disk!');
  } catch (error) {
    console.error('Transaction failed and automatically rolled back:', error.message);
  }
}

```

---

## 6. Querying Data via Indexes (`getFromIndex` / `getAllFromIndex`)

Secondary indexes allow querying records by properties other than the primary key.

```javascript
async function findUserByEmail(email) {
  const db = await initDB();

  // Fetch record using the 'by-email' index created during schema setup
  const user = await db.getFromIndex('users', 'by-email', email);

  if (user) {
    console.log(`Found user ${user.name} with email ${email}`);
  } else {
    console.log('No user found with that email.');
  }
  return user;
}

```

---

## 7. Efficient Batch Iteration with Cursors (`openCursor`)

When working with large datasets, fetching all items into memory using `db.getAll()` can cause performance bottlenecks. Use cursors to process records iteratively.

```javascript
async function updateInactiveUsers() {
  const db = await initDB();
  const tx = db.transaction('users', 'readwrite');
  let cursor = await tx.objectStore('users').openCursor();

  while (cursor) {
    // Access current record via cursor.value
    if (cursor.value.lastActive < Date.now() - 30 * 24 * 60 * 60 * 1000) {
      const updatedUser = { ...cursor.value, status: 'Inactive' };
      
      // Update record in place using cursor.update()
      await cursor.update(updatedUser);
    }

    // Advance to next record
    cursor = await cursor.continue();
  }

  await tx.done;
  console.log('Finished updating inactive users.');
}

```

---

## Summary Matrix

| Operation                  | Native IndexedDB Syntax                   | `idb` Async/Await Syntax                        |
| -------------------------- | ----------------------------------------- | ----------------------------------------------- |
| **Open DB**                | `const req = indexedDB.open(name, v)`     | `const db = await openDB(name, v, { upgrade })` |
| **Get Item**               | `tx.objectStore('s').get(key).onsuccess`  | `const item = await db.get('s', key)`           |
| **Put Item**               | `tx.objectStore('s').put(item).onsuccess` | `await db.put('s', item)`                       |
| **Transaction Completion** | `tx.oncomplete = () => {}`                | `await tx.done`                                 |
| **Query Index**            | `store.index('idx').get(val).onsuccess`   | `await db.getFromIndex('s', 'idx', val)`        |

Explain how to build an offline-first sync engine using idb and Service Workers with code examples

Building an **offline-first sync engine** allows users to read, update, create, and delete data without an internet connection. All actions are instantly committed to local storage using the **`idb` library** (IndexedDB) and UI state updates immediately. When connectivity is restored, a **Service Worker** syncs pending local mutations to the remote server in the background.

---

## 1. Architecture Overview

```text
               ┌─────────────────────────────────────────────────┐
               │                Main Thread UI                   │
               └──────────────┬───────────────────▲──────────────┘
                              │                   │
                     1. Write │                   │ 5. Sync Complete /
                        Local │                   │    UI Re-render
                              ▼                   │
               ┌──────────────────────────────────┴──────────────┐
               │  Local Storage (IndexedDB via `idb`)             │
               │  - Entity Stores (e.g. 'posts')                 │
               │  - Outbox Mutation Store ('sync-outbox')        │
               └──────────────┬──────────────────────────────────┘
                              │
                              │ 2. Register Background Sync Tag
                              ▼
               ┌─────────────────────────────────────────────────┐
               │           Service Worker Background             │
               │  - Listens for 'sync' event                     │
               │  - Reads 'sync-outbox' from `idb`               │
               │  - Sends HTTP POST/PUT/DELETE to API            │
               └──────────────┬──────────────────────────────────┘
                              │
                              │ 3. Send HTTP Batch Request
                              ▼
               ┌─────────────────────────────────────────────────┐
               │                Remote REST API                  │
               └─────────────────────────────────────────────────┘

```

---

## 2. Step 1: Database Setup (`db.js`)

Define two primary object stores:

1. **Entity Store (`posts`):** Stores local application records (cached from server or created offline).
2. **Outbox Store (`sync-outbox`):** Tracks pending mutations (POST, PUT, DELETE) queued while offline.

```javascript
// db.js
import { openDB } from 'idb';

const DB_NAME = 'OfflineSyncApp';
const DB_VERSION = 1;

export async function initDB() {
  return openDB(DB_NAME, DB_VERSION, {
    upgrade(db) {
      // 1. Data Store
      if (!db.objectStoreNames.contains('posts')) {
        db.createObjectStore('posts', { keyPath: 'id' });
      }

      // 2. Outbox Store for offline mutations
      if (!db.objectStoreNames.contains('sync-outbox')) {
        const outbox = db.createObjectStore('sync-outbox', {
          keyPath: 'id',
          autoIncrement: true,
        });
        outbox.createIndex('by-timestamp', 'timestamp');
      }
    },
  });
}

```

---

## 3. Step 2: Optimistic Local Writes & Queueing (`sync-manager.js`)

When a user creates or updates a record:

1. Generate a temporary client-side ID (e.g., `temp-1723000000000`).
2. Write the record directly to the `posts` store so the UI updates **instantly**.
3. Queue a mutation record into `sync-outbox`.
4. Register a Service Worker **Background Sync** event (`'sync-posts'`).

```javascript
// sync-manager.js
import { initDB } from './db.js';

export async function savePostOptimistically(postData) {
  const db = await initDB();

  // Create temporary record for immediate local rendering
  const tempId = postData.id || `temp-${Date.now()}`;
  const postRecord = { ...postData, id: tempId, syncStatus: 'pending' };

  // Use a transaction to update both stores atomically
  const tx = db.transaction(['posts', 'sync-outbox'], 'readwrite');
  
  // 1. Save to local data store
  await tx.objectStore('posts').put(postRecord);

  // 2. Save mutation payload to outbox queue
  await tx.objectStore('sync-outbox').put({
    tempId,
    endpoint: '/api/posts',
    method: postData.id && !postData.id.startsWith('temp') ? 'PUT' : 'POST',
    body: postData,
    timestamp: Date.now(),
  });

  await tx.done;

  // 3. Register Background Sync with Service Worker
  if ('serviceWorker' in navigator && 'SyncManager' in window) {
    const registration = await navigator.serviceWorker.ready;
    await registration.sync.register('sync-posts');
  } else {
    // Fallback: If Background Sync isn't supported, attempt sync immediately
    triggerManualSync();
  }

  return postRecord;
}

```

---

## 4. Step 3: Background Sync Processing (`sw.js`)

In the Service Worker:

1. Listen for the **`sync`** event matching the tag `'sync-posts'`.
2. Retrieve pending mutations from `sync-outbox` ordered by timestamp.
3. Post mutations to the server API.
4. Replace temporary client IDs with official server IDs and clear processed outbox items.

```javascript
// sw.js (Service Worker)
import { openDB } from 'idb';

const DB_NAME = 'OfflineSyncApp';
const DB_VERSION = 1;

self.addEventListener('sync', (event) => {
  if (event.tag === 'sync-posts') {
    event.waitUntil(processOutboxQueue());
  }
});

async function processOutboxQueue() {
  const db = await openDB(DB_NAME, DB_VERSION);
  const tx = db.transaction('sync-outbox', 'readonly');
  const mutations = await tx.objectStore('sync-outbox').getAll();

  for (const mutation of mutations) {
    try {
      console.log(`[SW Sync] Processing mutation ID ${mutation.id}...`);

      const response = await fetch(mutation.endpoint, {
        method: mutation.method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(mutation.body),
      });

      if (response.ok) {
        const serverData = await response.json();

        // Atomic update: swap temp ID for real server ID & remove outbox entry
        const updateTx = db.transaction(['posts', 'sync-outbox'], 'readwrite');
        
        // Remove temporary record if server generated a new ID
        if (mutation.tempId !== serverData.id) {
          await updateTx.objectStore('posts').delete(mutation.tempId);
        }

        // Save server-confirmed record
        await updateTx.objectStore('posts').put({ ...serverData, syncStatus: 'synced' });

        // Delete processed outbox item
        await updateTx.objectStore('sync-outbox').delete(mutation.id);

        await updateTx.done;
        
        // Notify open tabs about sync completion
        notifyTabs({ type: 'SYNC_COMPLETE', id: serverData.id });
      } else if (response.status >= 400 && response.status < 500) {
        // Unrecoverable client error (e.g. 400 Bad Request): discard outbox item
        await db.delete('sync-outbox', mutation.id);
      }
    } catch (error) {
      console.error(`[SW Sync] Network error during sync. Will retry later:`, error);
      // Re-throw error so the browser schedules a retry with exponential backoff
      throw error;
    }
  }
}

function notifyTabs(message) {
  self.clients.matchAll({ type: 'window' }).then((clients) => {
    clients.forEach((client) => client.postMessage(message));
  });
}

```

---

## 5. Step 4: Connecting the UI (`app.js`)

Render content directly from IndexedDB on page load. Listen for network change events and Service Worker sync notifications to refresh the view seamlessly.

```javascript
// app.js
import { initDB } from './db.js';
import { savePostOptimistically } from './sync-manager.js';

// 1. Initial Page Load: Render directly from local IndexedDB
async function renderPosts() {
  const db = await initDB();
  const posts = await db.getAll('posts');

  const listEl = document.getElementById('posts-list');
  listEl.innerHTML = posts
    .map(
      (p) => `
    <li>
      <strong>${p.title}</strong> 
      ${p.syncStatus === 'pending' ? '<span class="badge">⏳ Pending Sync</span>' : ''}
    </li>`
    )
    .join('');
}

// 2. Handle Form Submission
document.getElementById('post-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const titleInput = document.getElementById('post-title');

  // Perform instant optimistic save
  await savePostOptimistically({ title: titleInput.value });
  titleInput.value = '';

  // Re-render immediately from local store
  await renderPosts();
});

// 3. Listen for sync completion messages from Service Worker
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.addEventListener('message', (event) => {
    if (event.data.type === 'SYNC_COMPLETE') {
      console.log('Sync confirmed by server! Re-rendering UI...');
      renderPosts();
    }
  });
}

// Initial render
renderPosts();

```

